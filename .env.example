# ==============================================================================
# LALAO ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Add to .env.local)
# ------------------------------------------------------------------------------

# Convex Deployment URL (Required - generated when running `npx convex dev`)
VITE_CONVEX_URL="https://your-deployment-name.convex.cloud"

# App Public URL
VITE_APP_URL="http://localhost:3000"

# Cloudinary (Frontend image upload target)
VITE_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Paystack Public Key (For wallet funding & creator subscriptions)
VITE_PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# Web Push / FCM / OneSignal Public App Keys (Frontend push notification listener)
VITE_FIREBASE_VAPID_KEY="your-fcm-web-push-vapid-key"
VITE_VAPID_PUBLIC_KEY="your-web-push-vapid-public-key"
VITE_ONESIGNAL_APP_ID="0da46499-22a0-4035-8dfa-49f4395367da"

# Agora RTC Voice & Video Calling (Public App ID)
VITE_AGORA_APP_ID="your-agora-app-id"

# Playsole One Single Sign-On (Registered Client ID from https://one.playsole.xyz/admin)
VITE_PLAYSOLE_CLIENT_ID="lalao"


# ------------------------------------------------------------------------------
# 2. CONVEX BACKEND ENVIRONMENT VARIABLES (Configure in Convex Dashboard)
#    Settings -> Environment Variables (DO NOT expose these to the frontend!)
# ------------------------------------------------------------------------------

# Agora RTC Backend Token Credentials (DO NOT expose to frontend!)
AGORA_APP_ID="your-agora-app-id"
AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# App URL (For payment webhook callbacks & redirects)
APP_URL="http://localhost:3000"

# Cloudinary API Credentials (For generating server-side upload signatures)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Mux Video Streaming & Direct Uploads
MUX_TOKEN_ID="your-mux-token-id"
MUX_SECRET_KEY="your-mux-secret-key"

# BACHS Payment Gateway (Wallet Funding Provider - Never expose secret to frontend!)
# Set BACHS_ENVIRONMENT="sandbox" or "live"
BACHS_ENVIRONMENT="sandbox"
BACHS_SECRET_KEY="your-bachs-secret-key"
BACHS_WEBHOOK_SECRET="your-bachs-webhook-signing-secret"
BACHS_API_BASE_URL="https://sandbox-api.bachs.io"

# Paystack Secret Key (For Ads, Creator Subscriptions & Ticket purchases)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"

# Push Notifications (Web Push / Firebase FCM / OneSignal)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
FIREBASE_SERVER_KEY="your-legacy-fcm-server-key"
ONESIGNAL_APP_ID="0da46499-22a0-4035-8dfa-49f4395367da"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# VTU.ng Services (Airtime, Data, Utility bills)
# Set MARKET_PROVIDER="mock" for local/staging testing without live charges
MARKET_PROVIDER="mock"
VTU_API_BASE_URL="https://vtu.ng/wp-json"
VTU_USERNAME="your-vtu-username"
VTU_PASSWORD="your-vtu-password"
VTU_USER_PIN="your-vtu-webhook-pin"

# Google Gemini AI (For AI generation & assistants)
GEMINI_API_KEY="your-gemini-api-key"

# Resend Transactional Email Delivery (Configure in Convex Dashboard)
RESEND_API_KEY="re_123456789_your_resend_api_key"
RESEND_FROM_EMAIL="Lalao <onboarding@resend.dev>"

# Playsole One Auth Provider (Configure in Convex Dashboard)
PLAYSOLE_CLIENT_ID="lalao"
PLAYSOLE_CLIENT_SECRET="your-playsole-client-secret"

